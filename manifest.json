{
  "manifest_version": 3,
  "name": "Outfit Manager for Roblox",
  "version": "3.1.2",
  "description": "Organize outfits, generate random avatars, customize the UI, and clean up saved outfits.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.roblox.com/my/avatar*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
